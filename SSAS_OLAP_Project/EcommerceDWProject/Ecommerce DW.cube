  <MdxScripts>
    <MdxScript dwd:design-time-name="9849a086-818b-4601-a774-2adc3010eb36">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/


CALCULATE
;

CREATE MEMBER CURRENTCUBE.[Measures].[Margin Rate]
AS
    IIF(
        [Measures].[Net Revenue] = 0,
        NULL,
        [Measures].[Contribution Margin]
        / [Measures].[Net Revenue]
    ),
    FORMAT_STRING = "Percent",
    VISIBLE = 1
;

CREATE MEMBER CURRENTCUBE.[Measures].[AOV]
AS
    IIF(
        [Measures].[Order Count] = 0,
        NULL,
        [Measures].[Net Revenue]
        / [Measures].[Order Count]
    ),
    FORMAT_STRING = "#,##0.00",
    VISIBLE = 1
;

CREATE MEMBER CURRENTCUBE.[Measures].[Discount Rate]
AS
    IIF(
        [Measures].[Gross Sales] = 0,
        NULL,
        [Measures].[Discount Amount]
        / [Measures].[Gross Sales]
    ),
    FORMAT_STRING = "Percent",
    VISIBLE = 1
; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>