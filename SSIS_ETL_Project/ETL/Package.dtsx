                  refId="Package\03_Transform_And_Load_Dimensions\DFT_Load_Dim_Customer\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset">[dbo].[stg_product_catalog]</property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CustType AS (
    SELECT customer_id, MAX(customer_type) AS customer_type
    FROM dbo.stg_sales_full
    GROUP BY customer_id
)
SELECT 
    c.customer_id,
    c.customer_name,
    TRY_CONVERT(SMALLINT, c.customer_age) AS customer_age,
    c.gender,
    c.customer_segment,
    ISNULL(ct.customer_type, N'Regular') AS customer_type,
    c.customer_city,
    c.customer_state,
    c.customer_country,
    c.region,
    c.customer_postal_code,
    TRY_CONVERT(DECIMAL(18,4), c.customer_acquisition_cost) AS customer_acquisition_cost
FROM dbo.stg_customer_master c
LEFT JOIN CustType ct ON c.customer_id = ct.customer_id;</property>
