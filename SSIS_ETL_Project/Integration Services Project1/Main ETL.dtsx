                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    NULLIF(LTRIM(RTRIM(region)), '') AS region,
    NULLIF(LTRIM(RTRIM(customer_state)), '') AS [state],
    NULLIF(LTRIM(RTRIM(customer_country)), '') AS country
FROM dbo.stg_customer_master
WHERE region IS NOT NULL AND customer_state IS NOT NULL AND customer_country IS NOT NULL;</property>
