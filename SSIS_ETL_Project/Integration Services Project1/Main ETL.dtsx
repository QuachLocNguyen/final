                              description="Derived Column Expression"
                              name="Expression">(#{Package\03_Transform_And_Load_Dimensions\DFT_Load_Dim_Shipping\OLE DB Source.Outputs[OLE DB Source Output].Columns[shipping_method]} == "Same Day" || #{Package\03_Transform_And_Load_Dimensions\DFT_Load_Dim_Shipping\OLE DB Source.Outputs[OLE DB Source Output].Columns[shipping_method]} == "Express") ? "Fast" : (#{Package\03_Transform_And_Load_Dimensions\DFT_Load_Dim_Shipping\OLE DB Source.Outputs[OLE DB Source Output].Columns[shipping_method]} == "Standard" ? "Standard" : "Economy")</property>
