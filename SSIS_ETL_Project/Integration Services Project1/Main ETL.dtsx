                              dataType="System.String"
                              description="Derived Column Expression"
                              name="Expression">(#{Package\03_Transform_And_Load_Dimensions\DFT_Load_Dim_Marketing_Campaign\OLE DB Source.Outputs[OLE DB Source Output].Columns[marketing_channel]} == "Google Ads" || #{Package\03_Transform_And_Load_Dimensions\DFT_Load_Dim_Marketing_Campaign\OLE DB Source.Outputs[OLE DB Source Output].Columns[marketing_channel]} == "Facebook Ads" || #{Package\03_Transform_And_Load_Dimensions\DFT_Load_Dim_Marketing_Campaign\OLE DB Source.Outputs[OLE DB Source Output].Columns[marketing_channel]} == "Instagram" || #{Package\03_Transform_And_Load_Dimensions\DFT_Load_Dim_Marketing_Campaign\OLE DB Source.Outputs[OLE DB Source Output].Columns[marketing_channel]} == "TikTok" || #{Package\03_Transform_And_Load_Dimensions\DFT_Load_Dim_Marketing_Campaign\OLE DB Source.Outputs[OLE DB Source Output].Columns[marketing_channel]} == "YouTube" || #{Package\03_Transform_And_Load_Dimensions\DFT_Load_Dim_Marketing_Campaign\OLE DB Source.Outputs[OLE DB Source Output].Columns[marketing_channel]} == "Affiliate") ? "Paid Media" : ((#{Package\03_Transform_And_Load_Dimensions\DFT_Load_Dim_Marketing_Campaign\OLE DB Source.Outputs[OLE DB Source Output].Columns[marketing_channel]} == "Direct" || #{Package\03_Transform_And_Load_Dimensions\DFT_Load_Dim_Marketing_Campaign\OLE DB Source.Outputs[OLE DB Source Output].Columns[marketing_channel]} == "Email Marketing") ? "Owned Media" : "Organic Media")</property>
                            <property
                              containsID="true"
                              dataType="System.String"
                              description="Derived Column Friendly Expression"
                              expressionType="Notify"
                              name="FriendlyExpression">(marketing_channel == "Google Ads" || marketing_channel == "Facebook Ads" || marketing_channel == "Instagram" || marketing_channel == "TikTok" || marketing_channel == "YouTube" || marketing_channel == "Affiliate") ? "Paid Media" : ((marketing_channel == "Direct" || marketing_channel == "Email Marketing") ? "Owned Media" : "Organic Media")</property>
