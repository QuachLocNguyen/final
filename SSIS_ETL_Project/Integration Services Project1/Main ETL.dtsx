        <DTS:Executable
          DTS:refId="Package\03_Transform_And_Load_Dimensions\SQL_Load_Dim_Date"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{0E3FE7E8-2766-411C-9ADE-0260BEFE0038}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Load_Dim_Date"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2DEF1A70-DDB6-4F7D-8BE2-78E3708445CE}"
              SQLTask:SqlStatementSource="DECLARE @StartDate DATE = '2021-01-01';&#xA;DECLARE @EndDate DATE = '2026-12-31';&#xA;&#xA;WITH DateSequence AS (&#xA;    SELECT @StartDate AS [Date]&#xA;    UNION ALL&#xA;    SELECT DATEADD(DAY, 1, [Date])&#xA;    FROM DateSequence&#xA;    WHERE [Date] &lt; @EndDate&#xA;)&#xA;INSERT INTO dbo.Dim_Date (&#xA;    date_key, full_date, [year], [quarter], quarter_name,&#xA;    [month], month_name, [day], day_of_week, day_of_week_num,&#xA;    is_weekend, week_of_year, year_month, season, is_month_end&#xA;)&#xA;SELECT&#xA;    CAST(CONVERT(VARCHAR(8), [Date], 112) AS INT) AS date_key,&#xA;    [Date] AS full_date,&#xA;    YEAR([Date]) AS [year],&#xA;    DATEPART(QUARTER, [Date]) AS [quarter],&#xA;    'Q' + CAST(DATEPART(QUARTER, [Date]) AS VARCHAR(1)) AS quarter_name,&#xA;    MONTH([Date]) AS [month],&#xA;    DATENAME(MONTH, [Date]) AS month_name,&#xA;    DAY([Date]) AS [day],&#xA;    DATENAME(WEEKDAY, [Date]) AS day_of_week,&#xA;    DATEPART(WEEKDAY, [Date]) AS day_of_week_num,&#xA;    CASE WHEN DATEPART(WEEKDAY, [Date]) IN (1, 7) THEN 1 ELSE 0 END AS is_weekend,&#xA;    DATEPART(WEEK, [Date]) AS week_of_year,&#xA;    CONVERT(CHAR(7), [Date], 120) AS year_month,&#xA;    CASE &#xA;        WHEN MONTH([Date]) IN (3, 4, 5) THEN 'Spring'&#xA;        WHEN MONTH([Date]) IN (6, 7, 8) THEN 'Summer'&#xA;        WHEN MONTH([Date]) IN (9, 10, 11) THEN 'Autumn'&#xA;        ELSE 'Winter'&#xA;    END AS season,&#xA;    CASE WHEN [Date] = EOMONTH([Date]) THEN 1 ELSE 0 END AS is_month_end&#xA;FROM DateSequence&#xA;OPTION (MAXRECURSION 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
