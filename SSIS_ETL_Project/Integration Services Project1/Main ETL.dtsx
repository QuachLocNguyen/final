                <component
                  refId="Package\04_Load_Fact_Tables\DFT_Load_Fact_Sales\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH DeduplicatedItems AS (
    SELECT 
        order_id,
        product_id,
        CAST(quantity AS INT) AS quantity,
        CAST(gross_sales AS DECIMAL(18,4)) AS gross_sales,
        CAST(discount_amount AS DECIMAL(18,4)) AS discount_amount,
        CAST(tax_amount AS DECIMAL(18,4)) AS tax_amount,
        CAST(net_sales AS DECIMAL(18,4)) AS net_revenue,
        CAST(product_cost AS DECIMAL(18,4)) AS product_cost,
        CAST(shipping_cost AS DECIMAL(18,4)) AS shipping_cost_allocated,
        ROW_NUMBER() OVER (PARTITION BY order_id, product_id ORDER BY CAST(quantity AS INT) DESC) AS rn
    FROM dbo.stg_order_items
)
SELECT
    di.order_id,
    di.product_id,
    s.customer_id,
    CAST(CONVERT(VARCHAR(8), CAST(s.order_date AS DATE), 112) AS INT) AS date_key,
    s.region,
    s.customer_state,
    s.customer_country,
    s.order_status,
    s.payment_method,
    s.payment_status,
    s.sales_channel,
    s.delivery_status,
    s.marketing_channel,
    s.campaign_name,
    s.coupon_code,
    di.quantity,
    di.gross_sales,
    di.discount_amount,
    di.tax_amount,
    di.net_revenue,
    di.product_cost,
    di.shipping_cost_allocated
FROM DeduplicatedItems di
INNER JOIN dbo.stg_sales_full s ON di.order_id = s.order_id
WHERE di.rn = 1;</property>
